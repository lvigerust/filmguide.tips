{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"typegen": "openapi-typescript https://developer.themoviedb.org/openapi/tmdb-api.json -o src/lib/types/tmdb.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.5",
		"@lvigerust/components": "^0.1.9587",
		"@sveltejs/adapter-vercel": "7.0.0-next.8",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "3.0.0-next.25",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@toolwind/corner-shape": "0.0.8-3",
		"@types/node": "^22.20.5",
		"@upstash/redis": "^1.39.0",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^16.5.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"svelte-heros-v2": "^3.0.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vite-plugin-devtools-json": "^1.1.2",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#components": "./src/lib/components/index.js",
		"#components/*": "./src/lib/components/*",
		"#utils": "./src/lib/utils.js",
		"#types": "./src/lib/types/index.js",
		"#types/*": "./src/lib/types/*",
		"#api": "./src/lib/api/index.js",
		"#api/*": "./src/lib/api/*"
	}
}
